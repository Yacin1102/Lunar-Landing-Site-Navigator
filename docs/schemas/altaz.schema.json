{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yacin1102/Lunar-Landing-Site-Navigator/docs/schemas/altaz.schema.json",
  "type": "object",
  "title": "AltAzFixture",
  "description": "altaz.json, known-correct Sun and Earth directions for the TypeScript tests (Contract 6). Computed directly with SPICE, independently of the timetable. Pass mark: 0.01 degrees.",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Format version of this file. Increased on any format change."
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "AltAzCase",
        "description": "One test case.",
        "properties": {
          "name": {
            "type": "string",
            "description": "What the case is meant to expose."
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "Latitude, degrees, -90 to 90."
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Longitude, degrees, east positive, -180 to 180."
          },
          "elev_m": {
            "type": "number",
            "description": "Ground height, metres above the 1737.4 km sphere."
          },
          "mast_m": {
            "type": "number",
            "description": "Eye height above the ground, metres.",
            "minimum": 0
          },
          "t_ms": {
            "type": "integer",
            "description": "UTC time, milliseconds since 1970-01-01."
          },
          "sunEl": {
            "type": "number",
            "description": "Elevation of the centre of the Sun, degrees above the local level plane."
          },
          "sunAz": {
            "type": "number",
            "description": "Azimuth of the centre of the Sun, degrees from north, clockwise, 0 to 360.",
            "minimum": 0,
            "exclusiveMaximum": 360
          },
          "earthEl": {
            "type": "number",
            "description": "Elevation of the centre of the Earth, degrees."
          },
          "earthAz": {
            "type": "number",
            "description": "Azimuth of the centre of the Earth, degrees from north, clockwise, 0 to 360.",
            "minimum": 0,
            "exclusiveMaximum": 360
          }
        },
        "required": [
          "lat",
          "lon",
          "elev_m",
          "mast_m",
          "t_ms",
          "sunEl",
          "sunAz",
          "earthEl",
          "earthAz"
        ],
        "additionalProperties": false
      },
      "description": "The test cases.",
      "minItems": 1
    }
  },
  "required": [
    "version",
    "cases"
  ],
  "additionalProperties": false
}
